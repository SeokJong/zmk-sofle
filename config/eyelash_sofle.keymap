#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*
 * Key Position Aliases for Eyelash Sofle
 * Row 1: 0-12
 * Row 2: 13-25
 * Row 3: 26-38
 * Row 4: 39-51
 * Row 5: 52-63
 */
#define KEY_Q 14
#define KEY_W 15
#define KEY_S 28
#define KEY_D 29
#define KEY_F 30
#define KEY_Z 40
#define KEY_J 34
#define KEY_K 35
#define KEY_L3 54  // Layer 3 (NUM) 버튼
#define KEY_L4 53  // Layer 4 (SYS) 버튼

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    ht: ht {
        compatible = "zmk,behavior-hold-tap";
        label = "HT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <180>;
        require-prior-idle-ms = <150>; // 오타 방지를 위한 입력 유휴 시간 요구
        flavor = "tap-preferred";
    };

    behaviors {
        td_esc_grave: td_esc_grave {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp GRAVE>;  // 탭: ESC, 더블탭: `
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <KEY_Q KEY_S KEY_Z>; // Q + S + Z
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <KEY_F KEY_J>;  // F + J 홈로우 Shift 위치
            timeout-ms = <50>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <KEY_J KEY_K>;  // J + K
            timeout-ms = <50>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <KEY_D KEY_F>;  // D + F
            timeout-ms = <50>;
        };

        combo_gaming {
            bindings = <&tog 5>;
            key-positions = <KEY_L4 KEY_L3>;  // Layer 3 + Layer 4 동시 입력
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&td_esc_grave   &kp N1      &kp N2      &kp N3       &kp N4       &kp N5       &kp UP_ARROW     &kp N6   &kp N7       &kp N8       &kp N9      &kp N0         &kp BACKSPACE
&kp TAB         &kp Q       &kp W       &kp E        &kp R        &kp T        &kp DOWN_ARROW   &kp Y    &kp U        &kp I        &kp O       &kp P          &kp BSLH
&ht LCTRL CAPS  &ht LGUI A  &ht LALT S  &ht LCTRL D  &ht LSHFT F  &ht LANG1 G  &kp LEFT_ARROW   &ht LANG1 H  &ht LSHFT J  &ht LCTRL K  &ht LALT L  &ht LGUI SEMI  &kp APOS
&kp LSHFT       &kp Z       &kp X       &kp C        &kp V        &kp B        &kp RIGHT_ARROW  &kp N    &kp M        &kp COMMA    &kp DOT     &kp FSLH       &ht RET RIGHT_SHIFT
&kp C_MUTE      &mo 4       &mo 3       &mo 2        &mo 1        &kp SPACE    &kp ENTER        &kp RET  &kp SPACE    &mo 1        &mo 2       &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "BASE";
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp EXCL   &kp AT   &kp HASH  &kp DLLR   &kp PRCNT    &trans  &kp CARET  &kp AMPS  &kp ASTRK  &kp MINUS  &kp PLUS   &kp EQUAL
&trans     &kp TILDE  &kp LT   &kp LBRC  &kp LPAR   &kp LBKT     &trans  &kp RBKT   &kp RPAR  &kp RBRC   &kp GT     &kp UNDER  &kp PIPE
&trans     &trans     &kp SQT  &kp DQT   &kp COLON  &kp SEMI     &trans  &kp FSLH   &kp BSLH  &kp QMARK  &kp LANG2  &trans     &trans
&trans     &trans     &trans   &trans    &trans     &trans       &trans  &trans     &trans    &trans     &trans     &trans     &trans
&trans     &trans     &trans   &trans    &trans     &trans       &trans  &trans     &trans    &trans     &trans     &trans
            >;

            display-name = "SYM";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
&kp GRAVE     &kp F1  &kp F2     &kp F3      &kp F4        &kp F5       &mmv MOVE_UP     &kp F6     &kp F7         &kp F8        &kp F9     &kp F10  &trans
&trans        &trans  &mkp LCLK  &mkp MCLK   &mkp RCLK     &mkp MB4     &mmv MOVE_DOWN   &kp PG_UP  &kp HOME       &kp UP        &kp END    &kp F11  &kp F12
&kp CAPSLOCK  &trans  &kp LC(D)  &kp LA(UP)  &kp LA(DOWN)  &mkp MB5     &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT       &kp DOWN      &kp RIGHT  &trans   &trans
&trans        &kp LC(Z)  &kp LC(X)  &kp LC(C)   &kp LC(V)     &trans    &mmv MOVE_RIGHT  &trans     &kp LC(LS(K))  &kp LC(FSLH)  &trans     &trans   &trans
&kp C_MUTE    &trans  &trans     &trans      &trans        &trans       &mkp LCLK        &trans     &trans         &trans        &trans     &trans
            >;

            display-name = "NAV";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &kp KP_NUM       &trans           &trans           &trans             &trans  &kp EQUAL  &kp FSLH   &kp ASTRK  &kp MINUS  &trans  &trans
&trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans             &trans  &kp N7     &kp N8     &kp N9     &kp PLUS   &trans  &trans
&trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans             &trans  &kp N4     &kp N5     &kp N6     &kp DOT    &trans  &trans
&trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0    &trans  &kp N1     &kp N2     &kp N3     &kp N0     &trans  &trans
&trans  &trans  &trans           &trans           &trans           &trans             &trans  &trans     &trans     &trans     &trans     &trans
            >;

            display-name = "NUM";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &trans  &trans           &trans           &trans      &trans     &trans       &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans           &trans           &trans             &trans  &trans           &trans           &trans      &trans     &trans       &trans
&trans  &out OUT_USB  &out OUT_BLE    &trans           &trans           &trans             &trans  &trans           &trans           &trans      &trans     &trans       &trans
&trans  &sys_reset    &trans          &bootloader      &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &trans  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &sys_reset  &soft_off  &bootloader  &trans
&trans  &trans        &trans          &rgb_ug RGB_OFF  &rgb_ug RGB_ON   &trans             &trans  &trans           &trans           &trans      &trans     &trans
            >;

            display-name = "SYS";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_5 {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4     &kp N5     &kp UP_ARROW     &kp N6   &kp N7     &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB    &kp Q   &kp W   &kp E     &kp R      &kp T      &kp DOWN_ARROW   &kp Y    &kp U      &kp I      &kp O    &kp P     &kp BSLH
&kp LCTRL  &kp A   &kp S   &kp D     &kp F      &kp G      &kp LEFT_ARROW   &kp H    &kp J      &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V      &kp B      &kp RIGHT_ARROW  &kp N    &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&kp C_MUTE &trans  &trans  &kp LALT  &kp SPACE  &kp SPACE  &kp ENTER        &kp RET  &kp SPACE  &trans     &trans   &kp DELETE
            >;

            display-name = "GAME";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };
};
